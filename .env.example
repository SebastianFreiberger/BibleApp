VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key, shown on the registration form.
# Only takes effect once Captcha protection is also enabled in Supabase ->
# Authentication -> Attack Protection (using the matching secret key there).
# Leave empty to register without a captcha.
VITE_TURNSTILE_SITE_KEY=

# Server-side only (read by netlify/functions/classify-mood.js) — no VITE_ prefix,
# so it never gets bundled into the client.
GROQ_API_KEY=
